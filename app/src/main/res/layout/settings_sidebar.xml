<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvSettingsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="8dp"/>

        <!-- Saved Logs -->
        <TextView
            android:id="@+id/headerSavedLogs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Saved Logs"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:background="?attr/selectableItemBackground"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <!-- Customize Section -->
        <LinearLayout
            android:id="@+id/sectionCustomize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerCustomize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Customize"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/arrowCustomize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentCustomize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Dark Mode Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dark Mode"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Transitions sub-section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ANIMATIONS &amp; TRANSITIONS"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:letterSpacing="0.1"
                    android:paddingStart="36dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Animation style"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <Spinner
                        android:id="@+id/spinnerTransitionStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Slide direction (only shown when style = Slide) -->
                <LinearLayout
                    android:id="@+id/rowSlideDirection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Slide from"
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"/>
                    <Spinner
                        android:id="@+id/spinnerSlideDirection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Position sub-section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="POSITION"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:letterSpacing="0.1"
                    android:paddingStart="36dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add button side"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <Spinner
                        android:id="@+id/spinnerFabPosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add button side gap (dp)"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <EditText
                        android:id="@+id/etFabMarginSide"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:hint="16"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add button bottom gap (dp)"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <EditText
                        android:id="@+id/etFabMarginBottom"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:hint="16"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tab bar position"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <Spinner
                        android:id="@+id/spinnerTabPosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show income/expense bar"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSummaryBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show tab bar"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchTabBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <Button
                    android:id="@+id/btnResetCustomize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="36dp"
                    android:layout_marginBottom="12dp"
                    android:text="Reset to defaults"
                    android:textSize="13sp"
                    android:backgroundTint="@color/surface_variant"
                    android:textColor="@color/text_secondary"/>

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <!-- Backup Section -->
        <LinearLayout
            android:id="@+id/sectionBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerBackup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Backup"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/arrowBackup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/optionExport"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Export"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground"/>

                <TextView
                    android:id="@+id/optionImport"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Import"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <!-- Budget Section -->
        <LinearLayout
            android:id="@+id/sectionBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerBudget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Budget"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:id="@+id/arrowBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Monthly toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Monthly Budget"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBudgetMonthly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

                <!-- Custom toggle -->
                <LinearLayout
                    android:id="@+id/rowBudgetCustom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Custom Budget"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/arrowBudgetCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginEnd="8dp"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBudgetCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Custom period picker (shown when custom is on) -->
                <LinearLayout
                    android:id="@+id/layoutCustomPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etCustomName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Label (e.g. Quarter)"
                        android:inputType="text"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Period duration:"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etCustomYears"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Yr"
                            android:inputType="number"
                            android:textSize="13sp"
                            android:layout_marginEnd="4dp"/>
                        <EditText
                            android:id="@+id/etCustomMonths"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Mo"
                            android:inputType="number"
                            android:textSize="13sp"
                            android:layout_marginEnd="4dp"/>
                        <EditText
                            android:id="@+id/etCustomWeeks"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Wk"
                            android:inputType="number"
                            android:textSize="13sp"
                            android:layout_marginEnd="4dp"/>
                        <EditText
                            android:id="@+id/etCustomDays"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Day"
                            android:inputType="number"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budget amount (₹):"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etCustomBudgetAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 10000"
                        android:inputType="numberDecimal"
                        android:textSize="13sp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

    </LinearLayout>
</ScrollView>
