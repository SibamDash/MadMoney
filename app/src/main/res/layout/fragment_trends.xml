<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Range selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/tvTrendsTitle"
                android:text="Trends"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <Spinner
                android:id="@+id/spinnerRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Custom range row (shown only for Custom) -->
        <LinearLayout
            android:id="@+id/layoutCustomRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCustomFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="From: —"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/tvCustomTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="To: —"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground"/>

            <Button
                android:id="@+id/btnApplyCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go"
                android:textSize="12sp"
                android:backgroundTint="@color/orange_primary"/>
        </LinearLayout>

        <!-- Legend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <View android:layout_width="14dp" android:layout_height="14dp"
                android:background="@color/color_income" android:layout_marginEnd="4dp"
                android:layout_gravity="center_vertical"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Income" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginEnd="16dp"/>
            <View android:layout_width="14dp" android:layout_height="14dp"
                android:background="@color/color_expense" android:layout_marginEnd="4dp"
                android:layout_gravity="center_vertical"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Expense" android:textSize="12sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <com.example.myapplication.BarChartView
            android:id="@+id/barChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/llMonthRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>
</ScrollView>
