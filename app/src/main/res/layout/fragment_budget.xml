                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Monthly Budget"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tvMonthLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <EditText
                        android:id="@+id/etMonthlyBudget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Set monthly limit (₹)"
                        android:inputType="numberDecimal"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                    <Button
                        android:id="@+id/btnSaveMonthly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set"
                        android:textSize="13sp"
                        android:backgroundTint="@color/orange_primary"/>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/progressMonthly"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/color_income"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvMonthlySpent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:text="Spent: ₹0"/>
                    <TextView
                        android:id="@+id/tvMonthlyRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/color_income"
                        android:text="Left: ₹0"/>
                </LinearLayout>

                <!-- Details toggle -->
                <TextView
                    android:id="@+id/tvMonthlyDetailsToggle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="▶ Details"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:background="?attr/selectableItemBackground"/>
                <LinearLayout
                    android:id="@+id/layoutMonthlyDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="6dp">
                    <TextView
                        android:id="@+id/tvMonthlyStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp"/>
                    <LinearLayout
                        android:id="@+id/llMonthlyLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Custom Budget Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider"
            app:cardBackgroundColor="@color/card_background"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:id="@+id/tvCustomTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Custom Budget"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/tvCustomLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <EditText
                        android:id="@+id/etCustomBudget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Set limit (₹)"
                        android:inputType="numberDecimal"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                    <Button
                        android:id="@+id/btnSaveCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set"
                        android:textSize="13sp"
                        android:backgroundTint="@color/orange_primary"/>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/progressCustom"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/color_income"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvCustomSpent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:text="Spent: ₹0"/>
                    <TextView
                        android:id="@+id/tvCustomRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/color_income"
                        android:text="Left: ₹0"/>
                </LinearLayout>

                <!-- Details toggle -->
                <TextView
                    android:id="@+id/tvCustomDetailsToggle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="▶ Details"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:background="?attr/selectableItemBackground"/>
                <LinearLayout
                    android:id="@+id/layoutCustomDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="6dp">
                    <TextView
                        android:id="@+id/tvCustomStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp"/>
                    <LinearLayout
                        android:id="@+id/llCustomLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
